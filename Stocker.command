#!/bin/bash
# Переходимо в папку, де лежить сам файл скрипта
cd "$(dirname "$0")"

echo "Запуск Stocker Pro..."
# Використовуємо прямий шлях до python всередині venv
./.venv/bin/python3 main.py

# Якщо програма впаде, термінал не закриється відразу, і ми побачимо помилку
echo "Програма завершила роботу. Натисніть будь-яку клавішу..."
read