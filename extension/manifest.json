{
  "manifest_version": 3,
  "name": "Stocker AI: Autonomous Collector",
  "version": "2.0",
  "permissions": ["alarms", "storage", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "*://contributor.stock.adobe.com/*",
    "*://submit.shutterstock.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://contributor.stock.adobe.com/*/insights/sales-earnings*",
        "*://submit.shutterstock.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}